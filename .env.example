# Prefer an immutable digest after CI has published the image.
APP_IMAGE=ghcr.io/your-github-user/owui-personal-slim@sha256:replace-after-ci
APP_BASE_URL=https://chat.la4rain.com
AI_BASE_URL=https://cpa.la4rain.com/v1
AI_DEFAULT_MODEL=gpt-5.6-sol
AI_DEFAULT_REASONING_EFFORT=high
# Emergency ceiling. Routine control is available in the administrator UI.
AI_PROGRESSIVE_SUMMARY_HARD_DISABLED=false

# La4RainGPT exposes exactly three modes: Fast/Luna, Balanced/Terra, Expert/Sol.
AI_MODEL_ALLOWLIST=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol
AI_MODEL_DENYLIST=
AI_UNKNOWN_MODEL_CONTEXT_TOKENS=128000
AI_MODEL_CONTEXT_OVERRIDES_JSON={}

# Responses image-generation tool models. Empty defaults to AI_DEFAULT_MODEL.
AI_RESPONSE_IMAGE_MODELS=

# Chat-model -> dedicated /v1/images/generations model routes.
# CPA defaults to this Grok mapping when the variable is omitted.
AI_DEDICATED_IMAGE_MODELS_JSON={"grok-4.5":"grok-imagine-image-quality"}
# CPA Imagine counts UTF-8 bytes, not displayed characters.
AI_IMAGE_PROMPT_MAX_BYTES=8000

# Lightweight in-process restaurant requirement guidance. Keep disabled until
# the initial restaurant-workbench account assignment is ready.
RESTAURANT_GUIDANCE_ENABLED=false

# Per-user active workspace and seven-day temporary retention.
USER_MAX_STORAGE_BYTES=3221225472
USER_MAX_ACTIVE_CONVERSATIONS=30
USER_MAX_PINNED_CONVERSATIONS=10
CONVERSATION_RETENTION_HOURS=168
MAINTENANCE_INTERVAL_MINUTES=60

# Optional Aliyun streaming TTS. Credentials are mounted by compose.tts.yaml;
# do not put AccessKey values in this file.
TTS_ALIYUN_APP_KEY=
TTS_ALIYUN_VOICES=longxiaochun:龙小淳

# Optional Volcengine V3 bidirectional streaming TTS. The new-console API Key
# is mounted by compose.tts-volcengine.yaml; never put it in this file.
TTS_VOLCENGINE_RESOURCE_ID=seed-tts-2.0
# Empty uses the 19 runtime-verified TTS 2.0 built-in voices. Set a
# comma-separated id:label list only when an installation needs a smaller set.
TTS_VOLCENGINE_VOICES=
TTS_SESSION_TTL_SECONDS=1800

# Hermes Profile-only settings (documentation; leave commented in the slim
# deployment .env). The current Hermes container uses network_mode: host, so
# its Profile .env reaches slim through the loopback-published port.
# SLIM_RESTAURANT_BRIDGE_URL=http://127.0.0.1:3001
# SLIM_RESTAURANT_BRIDGE_TOKEN=hbr_REPLACE_WITH_ONE_TIME_TOKEN
# SLIM_RESTAURANT_BRIDGE_TIMEOUT_SECONDS=900
# SLIM_RESTAURANT_BRIDGE_MAX_AUDIO_BYTES=26214400
# SLIM_RESTAURANT_BRIDGE_MAX_TOTAL_AUDIO_BYTES=104857600
